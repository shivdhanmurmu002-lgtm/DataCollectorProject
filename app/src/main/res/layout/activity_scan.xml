<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A">

    <!-- Camera Preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="#80000000">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Point camera at text and tap Capture"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvScanCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans: 0"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#FFFFFF" />

        <!-- Capture Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnManualEntry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Manual"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#616161"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="CAPTURE AND SCAN"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnReScan"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Re-scan"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#616161"
                android:textAllCaps="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Results Section -->
    <LinearLayout
        android:id="@+id/layoutResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone">

        <!-- Raw Text Preview -->
        <TextView
            android:id="@+id/tvRawText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:textSize="11sp"
            android:textColor="#757575"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extracted Data (tap to edit):"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:padding="12dp"
            android:paddingBottom="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExtractedData"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnSendToSheet"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="12dp"
            android:text="SEND TO GOOGLE SHEET"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
